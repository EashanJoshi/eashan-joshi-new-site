---
import Section from "./Section.astro";
import type { ResumeProps } from "@types";

type Props = ResumeProps;

const { description, href, label } = Astro.props;
---

<Section text="Resume" href="resume">
  <div class="flex flex-col items-center space-y-6 text-center">
    <div
      class="max-w-2xl rounded-xl border border-neutral/20 bg-[#1c232d]/75 px-6 py-4 backdrop-blur-md"
    >
      <p class="mb-4 text-base text-neutral-200">
        {description}
      </p>
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white transition duration-300 ease-in-out hover:bg-primary/80"
      >
        {label}
      </a>
    </div>
  </div>
</Section>
