---
import Section from "./Section.astro";
import type { SkillCategory } from "@types";

interface Props {
  skills: SkillCategory[];
}

const { skills } = Astro.props;
---

<Section text="Technical Skills" href="skills">
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-3"
  >
    {
      skills.map(({ title, items }) => (
        <div class="rounded-xl border border-neutral/20 bg-[#1c232d]/75 p-6 backdrop-blur-md">
          <h3 class="mb-4 text-xl font-semibold text-white">{title}</h3>
          <div class="flex flex-wrap gap-2 text-sm">
            {items.map((item) => (
              <span class="rounded-full bg-neutral-800 px-3 py-1 text-white">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Section>
