---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

{
  experience && experience.length > 0 && (
    <Section text="Work Experience" href="experience">
      <div class="space-y-6">
        {experience.map(({ company, position, startDate, endDate, summary }) => {
          const hasPosition = Boolean(position?.trim());
          const summaryItems = Array.isArray(summary)
            ? summary.filter((item) => Boolean(item?.trim()))
            : summary?.trim()
              ? [summary]
              : [];
          const hasSummary = summaryItems.length > 0;

          return (
            <div class="rounded-xl border border-neutral/20 bg-[#1c232d]/75 px-5 py-5 backdrop-blur-md sm:px-6">
              <h3
                class:list={[
                  "font-serif text-2xl font-semibold text-white",
                  hasPosition || hasSummary ? "mb-1.5" : "mb-1",
                ]}
              >
                {company}
              </h3>
              <div
                class:list={[
                  "flex flex-col items-start",
                  hasSummary ? "pb-5" : "",
                ]}
              >
                {hasPosition && (
                  <h4 class="mb-0.5 font-serif text-2xl font-medium text-primary">
                    {position}
                  </h4>
                )}
                <span class="pb-[2px] text-sm text-white/70">
                  {startDate} – {endDate}
                </span>
              </div>
              {hasSummary && (
                <ul class="list-none">
                  {summaryItems.map((log) => (
                    <li class="relative mb-3 pl-8 text-base text-neutral before:absolute before:top-1 before:left-0 before:content-[url(/check.svg)]">
                      {log}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          );
        })}
      </div>
    </Section>
  )
}
