---
import Menu from "@icons/Menu.astro";
import { Image } from "astro:assets";
import type { HeaderProps } from "@types";

type Props = HeaderProps;

const { siteLogo, author, navLinks } = Astro.props;
---

<header
  id="site-header"
  class="site-header sticky top-0 z-50 mx-auto flex w-full max-w-5xl justify-between border-b border-neutral/15 bg-[#1c232d]/90 px-5 py-6 backdrop-blur-md"
>
  <a
    href="/"
    class="flex min-w-0 shrink items-center gap-2 sm:gap-3"
    aria-label="Home link"
  >
    <Image
      class="size-8 shrink-0 rounded-full sm:size-[45px]"
      src={siteLogo}
      width="45"
      height="45"
      alt="website logo"
    />
    <span
      class="whitespace-nowrap text-xs font-medium tracking-tight text-white sm:text-base"
    >
      {author}
    </span>
  </a>

  <button
    type="button"
    id="menu-button"
    class="shrink-0 px-1.5 text-neutral sm:hidden"
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="main-menu"
  >
    <Menu />
  </button>

  <nav
    class="absolute top-20 right-5 hidden rounded-xl border border-neutral/30 bg-[#1c232d]/95 px-4 py-5 text-neutral backdrop-blur-md sm:static sm:block sm:border-0 sm:bg-transparent sm:p-0 sm:backdrop-blur-none"
    id="main-menu"
  >
    <ul class="gap-2 sm:flex">
      {
        navLinks.map((link) => (
          <li class="relative">
            <a
              class="nav-item relative block p-2 text-sm font-medium transition-all duration-500 after:absolute after:bottom-0 after:left-2/4 after:h-2 after:w-1 after:-translate-x-2/4 after:text-primary after:opacity-0 after:content-['•'] hover:text-white"
              href={link.href}
              {...(link.external
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
            >
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("#site-header");
  const button = document.querySelector("#menu-button");
  const menu = document.querySelector("#main-menu");
  const navItems = document.querySelectorAll("#main-menu > ul > li > a");

  if (header) {
    const abortController = new AbortController();
    const { signal } = abortController;

    const SCROLL_STOP_MS = 400;
    let scrollStopTimer: number | undefined;
    let isScrolling = false;

    const isMenuOpen = () =>
      button?.getAttribute("aria-expanded") === "true";

    const setHeaderHidden = (hidden: boolean) => {
      header.classList.toggle("is-hidden", hidden);
      header.toggleAttribute("inert", hidden);
      header.setAttribute("aria-hidden", hidden ? "true" : "false");
    };

    const showHeaderIfAllowed = () => {
      isScrolling = false;
      setHeaderHidden(false);
    };

    const onScroll = () => {
      if (isMenuOpen()) {
        setHeaderHidden(false);
        window.clearTimeout(scrollStopTimer);
        isScrolling = false;
        return;
      }

      if (!isScrolling) {
        isScrolling = true;
      }
      setHeaderHidden(true);

      window.clearTimeout(scrollStopTimer);
      scrollStopTimer = window.setTimeout(showHeaderIfAllowed, SCROLL_STOP_MS);
    };

    const toggleMenu = () => {
      menu?.classList.toggle("hidden");
      const isHidden = menu?.classList.contains("hidden");
      button?.setAttribute("aria-expanded", `${!isHidden}`);
      button?.setAttribute(
        "aria-label",
        isHidden ? "Open navigation menu" : "Close navigation menu",
      );

      if (!isHidden) {
        window.clearTimeout(scrollStopTimer);
        isScrolling = false;
        setHeaderHidden(false);
      }
    };

    button?.addEventListener("click", toggleMenu, { signal });
    navItems.forEach((item) => {
      item.addEventListener("click", toggleMenu, { signal });
    });

    window.addEventListener("scroll", onScroll, { passive: true, signal });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navItems.forEach((item) => {
              if (item.getAttribute("href") === `#${entry.target.id}`) {
                item.classList.add("text-white", "md:after:opacity-100");
              } else {
                item.classList.remove("text-white", "md:after:opacity-100");
              }
            });
          }
        });
      },
      { threshold: 0.5 },
    );

    document.querySelectorAll("section").forEach((section) => {
      observer.observe(section);
    });

    const onVisibilityChange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        document.querySelectorAll("section").forEach((section) => {
          observer.observe(section);
        });
      }
    };

    document.addEventListener("visibilitychange", onVisibilityChange, {
      signal,
    });

    const cleanup = () => {
      window.clearTimeout(scrollStopTimer);
      observer.disconnect();
      abortController.abort();
    };

    window.addEventListener("pagehide", cleanup, { signal });
    signal.addEventListener("abort", () => {
      window.clearTimeout(scrollStopTimer);
      observer.disconnect();
    });
  }
</script>

<style>
  .site-header {
    transition:
      transform 280ms ease,
      opacity 280ms ease;
    will-change: transform, opacity;
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
      will-change: auto;
    }
  }
</style>
