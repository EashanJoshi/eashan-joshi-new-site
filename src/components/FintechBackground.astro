---
/**
 * Full-viewport Canvas market chart (decorative fictional data only).
 */
---

<div class="fintech-background" aria-hidden="true">
  <canvas id="fintech-market-canvas" class="fintech-background__canvas"></canvas>
</div>

<style>
  .fintech-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    background: #151d2b;
  }

  .fintech-background__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  type Candle = {
    open: number;
    high: number;
    low: number;
    close: number;
    volume: number;
  };

  const canvas = document.getElementById(
    "fintech-market-canvas",
  ) as HTMLCanvasElement | null;

  if (!canvas) {
    // no-op
  } else {
    const ctx = canvas.getContext("2d");

    if (ctx) {
      const abort = new AbortController();
      const { signal } = abort;

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      let animationId = 0;
      let candles: Candle[] = [];
      let offsetX = 0;
      let width = 0;
      let height = 0;
      let dpr = 1;
      let slot = 20;
      let bodyWidth = 11;

      // Classic trading colors
      const BULL = "#22c55e";
      const BULL_WICK = "#4ade80";
      const BEAR = "#ef4444";
      const BEAR_WICK = "#f87171";
      const VOLUME_BULL = "rgba(34, 197, 94, 0.38)";
      const VOLUME_BEAR = "rgba(239, 68, 68, 0.32)";
      // Neutral light accent — visible on both green and red candles
      const LINE = "rgba(226, 232, 240, 0.88)";
      const LINE_MARKER = "#e2e8f0";

      const isMobile = () => window.innerWidth < 768;

      const mulberry32 = (seed: number) => {
        let t = seed >>> 0;
        return () => {
          t += 0x6d2b79f5;
          let r = Math.imul(t ^ (t >>> 15), 1 | t);
          r ^= r + Math.imul(r ^ (r >>> 7), 61 | r);
          return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
        };
      };

      const nextCandle = (rand: () => number, prevClose: number): Candle => {
        // Taller bodies only — wick extension length unchanged
        const drift = (rand() - 0.48) * 8.4;
        const open = prevClose;
        const close = Math.max(40, Math.min(160, open + drift));
        // Wick length beyond body (unchanged)
        const upperWick = 1.6 + rand() * 4.8;
        const lowerWick = 1.6 + rand() * 4.8;
        return {
          open,
          close,
          high: Math.max(open, close) + upperWick,
          low: Math.min(open, close) - lowerWick,
          volume: 0.28 + rand() * 0.72,
        };
      };

      const rebuildCandles = () => {
        const count = isMobile() ? 42 : 80;
        const rand = mulberry32(2026);
        candles = [];
        let price = 100;
        for (let i = 0; i < count; i += 1) {
          const candle = nextCandle(rand, price);
          candles.push(candle);
          price = candle.close;
        }
      };

      const resize = () => {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = window.innerWidth;
        height = window.innerHeight;
        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        slot = isMobile() ? 16 : 20;
        bodyWidth = isMobile() ? 8 : 11;
        rebuildCandles();
      };

      // Slightly tighter range → more vertical pixels per price unit (height only)
      const priceToY = (price: number, chartTop: number, chartH: number) => {
        const min = 40;
        const max = 160;
        return chartTop + chartH - ((price - min) / (max - min)) * chartH;
      };

      const forVisibleCandles = (
        scroll: number,
        draw: (candle: Candle, x: number) => void,
      ) => {
        const span = candles.length * slot;
        const startX = -((scroll % span) + span) % span;

        for (let i = 0; i < candles.length * 2; i += 1) {
          const x = startX + i * slot;
          if (x > width + slot || x + slot < -slot) continue;
          draw(candles[i % candles.length], x);
        }
      };

      const drawCandles = (chartTop: number, chartH: number) => {
        forVisibleCandles(offsetX, (candle, x) => {
          const cx = x + slot / 2;
          const yOpen = priceToY(candle.open, chartTop, chartH);
          const yClose = priceToY(candle.close, chartTop, chartH);
          const yHigh = priceToY(candle.high, chartTop, chartH);
          const yLow = priceToY(candle.low, chartTop, chartH);
          const bullish = candle.close >= candle.open;
          const bodyTop = Math.min(yOpen, yClose);
          const bodyH = Math.max(8, Math.abs(yClose - yOpen));

          // Wick (green/red) — thickness preserved
          ctx.strokeStyle = bullish ? BULL_WICK : BEAR_WICK;
          ctx.lineWidth = 1.6;
          ctx.beginPath();
          ctx.moveTo(cx, yHigh);
          ctx.lineTo(cx, yLow);
          ctx.stroke();

          // Body (green/red)
          ctx.fillStyle = bullish ? BULL : BEAR;
          ctx.strokeStyle = bullish ? BULL_WICK : BEAR_WICK;
          ctx.lineWidth = 1.1;
          ctx.beginPath();
          ctx.rect(cx - bodyWidth / 2, bodyTop, bodyWidth, bodyH);
          ctx.fill();
          ctx.stroke();
        });
      };

      const drawVolume = (volumeTop: number, volumeH: number) => {
        forVisibleCandles(offsetX, (candle, x) => {
          const bullish = candle.close >= candle.open;
          const barH = candle.volume * volumeH * 0.9;
          ctx.fillStyle = bullish ? VOLUME_BULL : VOLUME_BEAR;
          ctx.fillRect(
            x + (slot - bodyWidth) / 2,
            volumeTop + volumeH - barH,
            bodyWidth,
            barH,
          );
        });
      };

      const drawPriceLine = (chartTop: number, chartH: number) => {
        // Same OHLC sequence + same scroll as candles; y = closing price
        const points: { x: number; y: number }[] = [];
        forVisibleCandles(offsetX, (candle, x) => {
          points.push({
            x: x + slot / 2,
            y: priceToY(candle.close, chartTop, chartH),
          });
        });

        if (points.length < 2) return;

        points.sort((a, b) => a.x - b.x);

        ctx.strokeStyle = LINE;
        ctx.lineWidth = 1.5;
        ctx.lineJoin = "round";
        ctx.lineCap = "round";
        ctx.beginPath();
        ctx.moveTo(points[0].x, points[0].y);
        for (let i = 1; i < points.length; i += 1) {
          ctx.lineTo(points[i].x, points[i].y);
        }
        ctx.stroke();

        const markerEvery = isMobile() ? 8 : 6;
        for (let i = 0; i < points.length; i += markerEvery) {
          const p = points[i];
          ctx.beginPath();
          ctx.fillStyle = LINE_MARKER;
          ctx.arc(p.x, p.y, 2.4, 0, Math.PI * 2);
          ctx.fill();
        }
      };

      const drawFrame = () => {
        ctx.clearRect(0, 0, width, height);
        ctx.fillStyle = "rgba(21, 29, 43, 0.1)";
        ctx.fillRect(0, 0, width, height);

        // Slightly taller chart band for vertical size only
        const chartTop = height * 0.1;
        const chartH = height * 0.6;
        const volumeTop = chartTop + chartH + height * 0.04;
        const volumeH = height * 0.13;

        drawVolume(volumeTop, volumeH);
        drawCandles(chartTop, chartH);
        drawPriceLine(chartTop, chartH);
      };

      const tick = () => {
        if (document.visibilityState === "hidden") {
          animationId = 0;
          return;
        }

        const speed = isMobile() ? 0.6 : 0.95;
        offsetX += speed;
        drawFrame();
        animationId = window.requestAnimationFrame(tick);
      };

      const stop = () => {
        if (animationId) {
          window.cancelAnimationFrame(animationId);
          animationId = 0;
        }
      };

      const startLoop = () => {
        stop();
        if (!prefersReducedMotion && document.visibilityState !== "hidden") {
          animationId = window.requestAnimationFrame(tick);
        }
      };

      window.addEventListener(
        "resize",
        () => {
          resize();
          drawFrame();
          startLoop();
        },
        { signal },
      );

      document.addEventListener(
        "visibilitychange",
        () => {
          if (document.visibilityState === "hidden") {
            stop();
          } else {
            drawFrame();
            startLoop();
          }
        },
        { signal },
      );

      window.addEventListener(
        "pagehide",
        () => {
          stop();
          abort.abort();
        },
        { signal },
      );

      resize();
      drawFrame();
      startLoop();
    }
  }
</script>
