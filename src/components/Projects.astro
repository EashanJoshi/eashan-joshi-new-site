---
import Section from "./Section.astro";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;

function defaultPreviewLabel(href?: string) {
  if (!href) return "Preview";
  if (href.includes("github.com")) return "View repo";
  if (href.includes("drive.google.com")) return "View document";
  return "Preview";
}

function defaultSourceLabel(href?: string) {
  if (!href) return "Source";
  if (href.includes("github.com")) return "Source";
  if (href.includes("drive.google.com")) return "Notes";
  return "Source";
}
---

<Section text="Projects" href="projects">
  <div class="flex flex-wrap justify-between gap-6">
    {
      projects.map(
        ({
          name,
          summary,
          bullets,
          tech,
          linkPreview,
          linkSource,
          previewLabel,
          sourceLabel,
        }) => {
          const sameLink =
            Boolean(linkPreview) &&
            Boolean(linkSource) &&
            linkPreview === linkSource;

          return (
            <div class="mb-12 w-full overflow-hidden rounded-2xl border border-neutral/20 bg-[#1c232d]/75 backdrop-blur-md md:w-[48%]">
              <div class="flex h-full min-h-[480px] flex-col justify-between p-6">
                <div>
                  <h3 class="mb-4 font-serif text-2xl font-medium text-primary">
                    {name}
                  </h3>
                  <p class="mb-4 text-base text-neutral">{summary}</p>

                  {Array.isArray(bullets) && bullets.length > 0 && (
                    <ul class="mb-4 list-inside list-disc space-y-1 text-sm text-neutral">
                      {bullets.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  )}

                  {Array.isArray(tech) && tech.length > 0 && (
                    <div class="mb-4 flex flex-wrap gap-2 text-xs text-white">
                      {tech.map((t) => (
                        <span class="rounded-full bg-neutral-800 px-2 py-1">
                          {t}
                        </span>
                      ))}
                    </div>
                  )}
                </div>

                <div class="mt-auto flex gap-5 pt-2 text-white">
                  {sameLink && linkPreview && (
                    <a
                      href={linkPreview}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:underline"
                    >
                      {previewLabel ?? defaultPreviewLabel(linkPreview)}
                    </a>
                  )}
                  {!sameLink && linkSource && (
                    <a
                      href={linkSource}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:underline"
                    >
                      {sourceLabel ?? defaultSourceLabel(linkSource)}
                    </a>
                  )}
                  {!sameLink && linkPreview && (
                    <a
                      href={linkPreview}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:underline"
                    >
                      {previewLabel ?? defaultPreviewLabel(linkPreview)}
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        },
      )
    }
  </div>
</Section>
