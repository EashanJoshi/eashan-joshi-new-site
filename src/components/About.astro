---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { paragraphs, image, name } = Astro.props;
---

<Section text="About Me" href="about">
  <div class="flex flex-col items-center gap-12 md:flex-row md:gap-8">
    <Image
      class="object-cover"
      src={image}
      width="450"
      height="450"
      alt={name}
    />

    <div class="w-auto space-y-4 rounded-xl border border-neutral/20 bg-[#1c232d]/75 p-5 text-base text-neutral backdrop-blur-md md:p-6">
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</Section>
