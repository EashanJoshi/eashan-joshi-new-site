---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty, summary, latestWork, links } = Astro.props;
---

<section
  class="flex min-h-[85vh] flex-col items-center justify-start pt-10 text-center"
  id="hero"
>
  <div class="max-w-3xl">
    <div
      class="mb-6 inline-block max-w-full rounded-xl border border-neutral/20 bg-[#1c232d]/75 px-5 py-4 backdrop-blur-md sm:px-6 sm:py-5"
    >
      <h1
        class="mb-1 font-serif text-6xl font-bold tracking-tightest text-white sm:text-7xl md:mb-0 md:text-8xl"
      >
        {name}
      </h1>
      <p
        class="font-serif text-4xl leading-[46px] font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl"
      >
        {specialty}
      </p>
    </div>
    <p
      class="mb-6 rounded-xl border border-neutral/20 bg-[#1c232d]/75 px-5 py-4 text-base font-normal text-neutral backdrop-blur-md md:text-lg"
    >
      {summary}
    </p>
    <a
      href="#lets-connect"
      class="mb-10 inline-block rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white transition duration-300 hover:bg-primary/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-black"
    >
      Get in touch
    </a>
  </div>

  <div
    class="mt-4 mb-4 flex w-full flex-col items-stretch gap-6 px-4 md:flex-row"
  >
    <div
      class="flex min-h-[150px] flex-1 flex-col items-center justify-center rounded-xl border border-neutral/20 bg-[#1c232d]/75 p-4 backdrop-blur-md transition-colors duration-300 hover:border-primary/40"
    >
      <h3 class="mb-3 text-xl font-bold text-primary">{latestWork.title}</h3>
      <a
        href={latestWork.href}
        target="_blank"
        rel="noopener noreferrer"
        class="flex h-full w-full items-center justify-center"
        aria-label="Open CodeIntellect demo"
      >
        <video
          id="latestVideo"
          src={latestWork.videoSrc}
          muted
          playsinline
          preload="metadata"
          class="h-[95%] w-[95%] rounded-md object-cover"></video>
      </a>
    </div>

    <div class="flex flex-1 flex-col gap-4">
      {
        links.map(({ title, description, href }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-[96px] flex-col justify-center rounded-xl border border-neutral/20 bg-[#1c232d]/75 p-4 text-left text-white backdrop-blur-md transition-colors duration-300 hover:border-primary/40"
          >
            <h3 class="mb-1 text-lg font-bold text-primary">{title}</h3>
            <p class="text-xs text-neutral">{description}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  const video = document.getElementById(
    "latestVideo",
  ) as HTMLVideoElement | null;
  if (!video) {
    // no-op
  } else {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!prefersReducedMotion) {
      video.autoplay = true;
      void video.play().catch(() => {});
    }

    video.addEventListener("timeupdate", () => {
      if (video.currentTime >= 5) {
        video.currentTime = 0;
        if (!prefersReducedMotion) {
          void video.play().catch(() => {});
        }
      }
    });
  }
</script>
